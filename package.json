{
    "name": "strix",
    "private": true,
    "version": "0.2.14",
    "workspaces": [
        "apps/desktop",
        "packages/*"
    ],
    "scripts": {
        "dev": "node scripts/dev.mjs m1",
        "dev:app": "node scripts/dev.mjs m1",
        "dev:app:competition": "node scripts/dev.mjs competition",
        "dev:renderer": "npm --workspace @strix/desktop run dev",
        "update:serve": "node scripts/update-server.mjs",
        "update:publish": "node scripts/update-publish.mjs",
        "update:publish:competition": "node scripts/update-publish.mjs competition",
        "update:ship": "npm run package:m1 && node scripts/update-publish.mjs m1",
        "update:ship:competition": "npm run package:competition && node scripts/update-publish.mjs competition",
        "package:m1:selfhost": "node scripts/edition.mjs m1 win --selfhost",
        "update:ship:selfhost": "npm run package:m1:selfhost && node scripts/update-publish.mjs m1",
        "start:m1": "node scripts/edition.mjs m1 start",
        "start:competition": "node scripts/edition.mjs competition start",
        "build:m1": "node scripts/edition.mjs m1 build",
        "build:competition": "node scripts/edition.mjs competition build",
        "package:m1": "node scripts/edition.mjs m1 win",
        "package:competition": "node scripts/edition.mjs competition win",
        "build": "tsc --build",
        "typecheck": "tsc --build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "watch": "tsc --build --watch",
        "watch:types": "tsc --build --watch",
        "ai:setup": "node scripts/ai-setup.mjs",
        "ai:start": "node freellmapi/server/dist/index.js",
        "collab:start": "node node_modules/y-websocket/bin/server.cjs",
        "verify:package": "node scripts/verify-package.mjs",
        "check:manifest": "node scripts/check-manifest.mjs",
        "security": "node scripts/security-scan.mjs",
        "security:audit": "npm audit --omit=dev",
        "security:ci": "node scripts/security-scan.mjs && npm audit --omit=dev --audit-level=critical",
        "prepare": "git config core.hooksPath .githooks || exit 0",
        "bootstrap": "npm install"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.0",
        "electron-builder": "^24.0.0",
        "eslint": "^9.0.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.0.0",
        "sharp": "^0.35.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.59.4",
        "vite": "^6.0.0",
        "vitest": "^1.4.0"
    },
    "overrides": {
        "sha.js": "2.4.11"
    }
}
