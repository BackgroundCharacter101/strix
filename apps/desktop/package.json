{
    "name": "@strix/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "build:main": "tsc -p .",
        "build:renderer": "cd renderer && vite build",
        "build:app": "npm run build:main && npm run build:renderer",
        "start:app": "npm run build:app && electron .",
        "start": "npm run start:app",
        "dev:renderer": "cd renderer && vite",
        "dev": "npm run dev:renderer",
        "package": "npm run build:app && electron-builder --win",
        "package:dir": "npm run build:app && electron-builder --dir"
    },
    "build": {
        "appId": "com.strix.ide",
        "productName": "Strix",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "renderer/dist/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "**/node_modules/node-pty/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false
        }
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "electron": "^32.0.0",
        "isomorphic-git": "^1.38.1",
        "monaco-editor": "^0.52.2",
        "node-pty": "^1.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "y-monaco": "^0.1.6",
        "y-websocket": "^2.1.0",
        "yjs": "^13.6.30"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "electron-builder": "^25.1.8",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    }
}
