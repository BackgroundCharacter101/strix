{
    "name": "@strix/desktop",
    "version": "0.2.18",
    "private": true,
    "type": "module",
    "description": "Strix — an AI-native desktop IDE.",
    "author": "Strix",
    "main": "dist/main/index.cjs",
    "scripts": {
        "build:main": "tsc -p . && node esbuild.main.mjs",
        "build:renderer": "cd renderer && vite build",
        "build:app": "npm run build:main && npm run build:renderer",
        "start:app": "npm run build:app && electron .",
        "start": "npm run start:app",
        "dev:renderer": "cd renderer && vite",
        "dev": "npm run dev:renderer",
        "start:m1": "node ../../scripts/edition.mjs m1 start",
        "start:competition": "node ../../scripts/edition.mjs competition start",
        "build:m1": "node ../../scripts/edition.mjs m1 build",
        "build:competition": "node ../../scripts/edition.mjs competition build",
        "package:m1": "node ../../scripts/edition.mjs m1 win",
        "package:competition": "node ../../scripts/edition.mjs competition win",
        "package": "node ../../scripts/edition.mjs m1 win",
        "package:linux": "node ../../scripts/edition.mjs m1 linux",
        "package:mac": "node ../../scripts/edition.mjs m1 mac",
        "package:dir": "node ../../scripts/edition.mjs m1 dir"
    },
    "build": {
        "appId": "com.strix.ide",
        "productName": "Strix",
        "electronVersion": "32.3.3",
        "asar": true,
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "renderer/dist/**/*",
            "build/icon.png",
            "package.json"
        ],
        "asarUnpack": [
            "**/node_modules/node-pty/**/*"
        ],
        "extraResources": [
            {
                "from": "../../freellmapi/.bundle",
                "to": "freellmapi/.bundle",
                "filter": [
                    "**/*",
                    "!**/*.map",
                    "!**/*.ts",
                    "!**/*.md"
                ]
            }
        ],
        "win": {
            "icon": "build/icon.png",
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "license": "build/license.txt",
            "runAfterFinish": true,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "deleteAppDataOnUninstall": false,
            "installerSidebar": "build/installerSidebar.bmp",
            "uninstallerSidebar": "build/installerSidebar.bmp",
            "installerHeader": "build/installerHeader.bmp"
        },
        "linux": {
            "icon": "build/icon.png",
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development",
            "synopsis": "An AI-native desktop IDE.",
            "maintainer": "Strix <strix@example.com>"
        },
        "mac": {
            "icon": "build/icon.png",
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.developer-tools"
        }
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/addon-webgl": "^0.18.0",
        "@xterm/xterm": "^5.5.0",
        "isomorphic-git": "^1.38.1",
        "monaco-editor": "^0.52.2",
        "node-pty": "^1.1.0",
        "pdfjs-dist": "^4.10.38",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "y-monaco": "^0.1.6",
        "y-websocket": "^2.1.0",
        "yjs": "^13.6.30"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "electron": "^32.0.0",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    }
}
