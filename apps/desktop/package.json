{
    "name": "@strix/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Strix — an AI-native desktop IDE.",
    "author": "Strix",
    "main": "dist/main/index.js",
    "scripts": {
        "build:main": "tsc -p . && node esbuild.main.mjs",
        "build:renderer": "cd renderer && vite build",
        "build:app": "npm run build:main && npm run build:renderer",
        "start:app": "npm run build:app && electron .",
        "start": "npm run start:app",
        "dev:renderer": "cd renderer && vite",
        "dev": "npm run dev:renderer",
        "package": "npm run build:app && electron-builder --win",
        "package:linux": "npm run build:app && electron-builder --linux",
        "package:mac": "npm run build:app && electron-builder --mac",
        "package:dir": "npm run build:app && electron-builder --dir"
    },
    "build": {
        "appId": "com.strix.ide",
        "productName": "Strix",
        "electronVersion": "32.3.3",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "renderer/dist/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "**/node_modules/node-pty/**/*"
        ],
        "extraResources": [
            {
                "from": "../../freellmapi",
                "to": "freellmapi",
                "filter": [
                    "package.json",
                    "shared/**/*",
                    "server/package.json",
                    "server/dist/**/*",
                    "client/dist/**/*",
                    "server/node_modules/**/*",
                    "node_modules/**/*",
                    "!**/node_modules/{vitest,@vitest,vite,vite-node,rollup,@rollup,tsx,esbuild,@esbuild,@esbuild-kit,drizzle-kit,typescript,@types}/**",
                    "!**/*.exe",
                    "!**/*.map",
                    "!**/*.ts",
                    "!**/__tests__/**"
                ]
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development",
            "synopsis": "An AI-native desktop IDE.",
            "maintainer": "Strix <strix@example.com>"
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.developer-tools"
        }
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "isomorphic-git": "^1.38.1",
        "monaco-editor": "^0.52.2",
        "node-pty": "^1.1.0",
        "pdfjs-dist": "^4.10.38",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "y-monaco": "^0.1.6",
        "y-websocket": "^2.1.0",
        "yjs": "^13.6.30"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "electron": "^32.0.0",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    }
}
